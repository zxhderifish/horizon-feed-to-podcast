# Copy to .env and fill in. Loaded with: set -a && source .env && set +a

# Text-to-speech (Google AI Studio: https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Optional: pin a TTS model. TTS model ids get renamed and retired, so if
# synthesis 404s, list what your key can actually see (see tools/podcast_tts.py)
# and set it here.
# GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview

# S3-compatible object storage for episode audio (example: Cloudflare R2).
# The bucket name and public URL live in config.toml, not here.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Optional: only needed if you poll GitHub releases. Unauthenticated requests
# work but are rate-limited; a read-only token raises the ceiling.
# GITHUB_TOKEN=

# --- Local TTS (optional; docs/local-tts-setup.md) --------------------------
# Narrate with a local model instead of Gemini, which stays as the automatic
# fallback. Nothing here is needed for the Gemini-only path.

# The interpreter that has vllm + vllm-omni installed. Required for the local
# path when the GPU is on this machine — vLLM is too heavy for the pipeline's
# own venv, so this is a second one.
# TTS_PYTHON=~/horizon-tts/.venv/bin/python

# Only if the GPU is on another box: an ssh target (a Host from ~/.ssh/config,
# or user@host). Unset means same machine, and no SSH is involved at all.
# TTS_REMOTE_HOST=gpu-box
# TTS_REMOTE_DIR=~/horizon-tts

# Number of independent local-model draws per segment. 1 preserves the
# lowest-memory behavior. Set to 2 on a sufficiently large GPU to enable the
# loudness gate plus faster-whisper judge described in docs/local-tts-setup.md.
# TTS_TAKES=2

# Set to 0 to skip the local path entirely. Default is local-first.
# TTS_LOCAL=0
